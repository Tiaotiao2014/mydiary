{
  "name": "mydiary",
  "version": "0.1.0",
  "description": "纯本地日记软件 - MyDiary",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build && electron-builder",
    "start": "electron .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tiptap/extension-image": "^2.4.0",
    "@tiptap/extension-table": "^2.4.0",
    "@tiptap/pm": "^2.4.0",
    "@tiptap/starter-kit": "^2.4.0",
    "better-sqlite3": "^11.0.0",
    "electron-store": "^8.2.0",
    "vue": "^3.4.0",
    "pinia": "^2.2.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@tiptap/vue-3": "^2.4.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0",
    "vue-tsc": "^2.0.0"
  }
