{
  "name": "mydiary",
  "version": "0.1.0",
  "description": "纯本地日记软件 - MyDiary",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && node scripts/start.cjs --dev\"",
    "build": "vite build && electron-builder",
    "build:vite": "vite build",
    "start": "node scripts/start.cjs",
    "run": "node scripts/start.cjs",
    "test": "node tests/zip-paths.test.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-mathematics": "2.27.3",
    "@tiptap/extension-table": "2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "2.27.3",
    "@tiptap/extension-table-row": "2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "archiver": "^7.0.1",
    "electron-store": "^8.2.0",
    "katex": "^0.16.0",
    "pinia": "^2.2.0",
    "vue": "^3.4.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@tiptap/vue-3": "^2.27.3",
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.mydiary.app",
    "productName": "MyDiary",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
